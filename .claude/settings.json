{
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep",
      "Bash(git status)", "Bash(git diff*)", "Bash(git log*)", "Bash(git branch*)", "Bash(git show*)",
      "Bash(ls*)", "Bash(find *)",
      "Bash(uvicorn*)", "Bash(npm run dev)",
      "Bash(pytest*)", "Bash(npm test*)",
      "mcp__railway__list-*", "mcp__railway__get-*", "mcp__railway__whoami", "mcp__railway__search-docs",
      "mcp__vercel__list_*", "mcp__vercel__get_*",
      "mcp__github__list_*", "mcp__github__search_*", "mcp__github__get_*"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  }
}
